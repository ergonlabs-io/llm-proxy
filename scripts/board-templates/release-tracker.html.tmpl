<title>llm-proxy · release tracker</title>
<style>
  :root {
    --ground: #eceef1; --surface: #ffffff; --sunk: #e2e6ea;
    --ink: #151d26; --muted: #5d6b7a; --faint: #8a97a4; --line: #d2d9df;
    --signal: #b4470f; --signal-bg: #fbeade; --signal-line: #e8a575;
    --shipped: #1a6b40; --shipped-bg: #e0efe6;
    --future: #6b7684; --future-bg: #e7eaee;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #0d1218; --surface: #161d25; --sunk: #111820;
      --ink: #e6ecf2; --muted: #97a4b2; --faint: #6d7b8a; --line: #26303b;
      --signal: #f0894a; --signal-bg: #2e1b10; --signal-line: #7a441f;
      --shipped: #4fb37c; --shipped-bg: #12281c;
      --future: #8896a4; --future-bg: #1b232c;
    }
  }
  :root[data-theme="light"] {
    --ground: #eceef1; --surface: #ffffff; --sunk: #e2e6ea;
    --ink: #151d26; --muted: #5d6b7a; --faint: #8a97a4; --line: #d2d9df;
    --signal: #b4470f; --signal-bg: #fbeade; --signal-line: #e8a575;
    --shipped: #1a6b40; --shipped-bg: #e0efe6;
    --future: #6b7684; --future-bg: #e7eaee;
  }
  :root[data-theme="dark"] {
    --ground: #0d1218; --surface: #161d25; --sunk: #111820;
    --ink: #e6ecf2; --muted: #97a4b2; --faint: #6d7b8a; --line: #26303b;
    --signal: #f0894a; --signal-bg: #2e1b10; --signal-line: #7a441f;
    --shipped: #4fb37c; --shipped-bg: #12281c;
    --future: #8896a4; --future-bg: #1b232c;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--ground); color: var(--ink);
    font-family: var(--sans); font-size: 15px; line-height: 1.55;
  }
  .wrap { max-width: 900px; margin: 0 auto; padding: 40px 24px 64px; }

  .eyebrow {
    font-family: var(--mono); font-size: 11px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--faint); margin: 0 0 10px;
  }
  h1 {
    font-family: var(--mono); font-size: 27px; font-weight: 600;
    letter-spacing: -.02em; margin: 0 0 8px; text-wrap: balance;
  }
  .lede { color: var(--muted); font-size: 15px; max-width: 68ch; margin: 0 0 30px; }
  .lede strong { color: var(--ink); font-weight: 600; }

  /* --- the ladder ---------------------------------------------------- */
  .ladder { display: flex; flex-direction: column; gap: 0; }
  .rel {
    display: grid; grid-template-columns: 92px 1fr; gap: 20px;
    position: relative; padding-bottom: 22px;
  }
  .rel::before {
    content: ""; position: absolute; left: 91px; top: 22px; bottom: -4px;
    width: 2px; background: var(--line);
  }
  .rel:last-child::before { display: none; }

  .spine { text-align: right; padding-top: 12px; position: relative; }
  .ver {
    font-family: var(--mono); font-size: 14px; font-weight: 700;
    font-variant-numeric: tabular-nums; letter-spacing: -.01em;
  }
  .when { font-family: var(--mono); font-size: 10.5px; color: var(--faint); margin-top: 2px; }
  .dot {
    position: absolute; right: -25px; top: 16px;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--ground); border: 2px solid var(--line);
  }
  .rel.current .dot { border-color: var(--signal); background: var(--signal); box-shadow: 0 0 0 4px var(--signal-bg); }
  .rel.shipped .dot { border-color: var(--shipped); background: var(--shipped); }

  .body {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 8px; padding: 16px 18px;
  }
  .rel.current .body { border-color: var(--signal-line); border-left: 3px solid var(--signal); }

  .head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; }
  .name { font-size: 17px; font-weight: 650; letter-spacing: -.01em; }
  .tag {
    font-family: var(--mono); font-size: 10px; font-weight: 700;
    padding: 2px 7px; border-radius: 4px; letter-spacing: .05em; text-transform: uppercase;
  }
  .tag.now { background: var(--signal-bg); color: var(--signal); }
  .tag.done { background: var(--shipped-bg); color: var(--shipped); }
  .tag.later { background: var(--future-bg); color: var(--future); }
  .theme { color: var(--muted); font-size: 14px; margin: 0 0 12px; }

  .gate {
    background: var(--sunk); border-radius: 6px; padding: 11px 13px; margin: 0 0 12px;
    border-left: 2px solid var(--signal);
  }
  .gate .lbl {
    font-family: var(--mono); font-size: 10px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--signal); font-weight: 700;
    display: block; margin-bottom: 4px;
  }
  .gate p { margin: 0; font-size: 13.5px; line-height: 1.5; }
  .gate .verify {
    display: block; margin-top: 7px; font-family: var(--mono);
    font-size: 11.5px; color: var(--muted);
  }

  /* --- progress ------------------------------------------------------ */
  .prog { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; }
  .bar { flex: 1; height: 7px; border-radius: 4px; background: var(--sunk); overflow: hidden; display: flex; }
  .bar i { display: block; height: 100%; }
  .bar .b-done { background: var(--shipped); }
  .bar .b-open { background: var(--signal); }
  .count {
    font-family: var(--mono); font-size: 11.5px; color: var(--muted);
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }

  .subhead {
    font-family: var(--mono); font-size: 10.5px; letter-spacing: .07em;
    text-transform: uppercase; color: var(--faint); margin: 14px 0 7px; font-weight: 700;
  }
  ul.items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  ul.items li { display: grid; grid-template-columns: 62px 1fr; gap: 10px; font-size: 13.5px; align-items: baseline; }
  ul.items .wp {
    font-family: var(--mono); font-size: 11.5px; font-weight: 700; color: var(--signal);
  }
  .rel.shipped ul.items .wp, .rel.later ul.items .wp { color: var(--muted); }
  ul.items .what { color: var(--muted); }
  ul.items .what b { color: var(--ink); font-weight: 600; }

  .risk {
    margin-top: 13px; padding: 9px 12px; border-radius: 6px;
    background: var(--signal-bg); border: 1px solid var(--signal-line);
    font-size: 13px; line-height: 1.5; color: var(--ink);
  }
  .risk b { font-family: var(--mono); font-size: 11.5px; letter-spacing: .03em; text-transform: uppercase; color: var(--signal); }

  .scope { font-size: 13px; color: var(--muted); margin: 12px 0 0; }
  .scope b { color: var(--ink); font-weight: 600; }

  code {
    font-family: var(--mono); font-size: .88em;
    background: var(--sunk); padding: 1px 5px; border-radius: 3px;
  }

  /* --- rules --------------------------------------------------------- */
  .rules { margin-top: 42px; border-top: 1px solid var(--line); padding-top: 26px; }
  .rules h2 { font-family: var(--mono); font-size: 16px; font-weight: 650; margin: 0 0 4px; }
  .rules .sub { color: var(--muted); font-size: 14px; margin: 0 0 18px; max-width: 66ch; }
  ol.steps { list-style: none; counter-reset: s; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  ol.steps li {
    counter-increment: s; display: grid; grid-template-columns: 26px 1fr; gap: 12px;
    font-size: 14px; align-items: baseline;
  }
  ol.steps li::before {
    content: counter(s);
    font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--signal);
    background: var(--signal-bg); border-radius: 4px; text-align: center;
    padding: 2px 0; align-self: start; margin-top: 2px;
  }
  ol.steps b { font-weight: 650; }
  ol.steps span { color: var(--muted); }
  .kicker {
    margin-top: 20px; padding: 12px 14px; background: var(--surface);
    border: 1px solid var(--line); border-radius: 7px; font-size: 13.5px; line-height: 1.55;
  }
  .kicker b { font-weight: 650; }

  footer { margin-top: 34px; font-family: var(--mono); font-size: 11.5px; color: var(--faint); }

  @media (max-width: 620px) {
    .rel { grid-template-columns: 1fr; gap: 8px; }
    .rel::before { display: none; }
    .spine { text-align: left; padding-top: 0; display: flex; align-items: baseline; gap: 8px; }
    .dot { display: none; }
    .when { margin-top: 0; }
    ul.items li { grid-template-columns: 1fr; gap: 1px; }
  }
</style>

<div class="wrap">
  <p class="eyebrow">llm-proxy · release tracking · latest release v0.3.1 · planning updated 2026-10-10 · test totals: <code>make tq-count</code></p>
  <h1>Release tracker</h1>
  <p class="lede">
    Six releases, each with exactly one <strong>ship gate</strong>: a single objectively checkable
    statement. Not "done enough" — checkable. If a gate needs someone to argue that it passed, it
    isn't a gate. Normative copy lives in <code>internal-docs/MILESTONES.md</code>; this is the view.
  </p>

  <div class="ladder" id="ladder"></div>

  <section class="rules">
    <h2>How a ticket earns its slot</h2>
    <p class="sub">Answer in order. The first question that discriminates wins.</p>
    <ol class="steps">
      <li><b>Does it block the current ship gate?</b> <span>Then it is the work. Nothing below matters.</span></li>
      <li><b>Is it a correctness or security defect on a path we already serve?</b> <span>Ship gates don't protect broken behavior that's already live. The missing-credentials P0, the access-log credential leak, and all four QA-suite findings came in this way — the last of which is why the suite outranks feature work when it reports.</span></li>
      <li><b>Does it violate a ground rule?</b> <span>A silently ignored config field is a P0 by definition. Usually small, always ahead of feature work in the same milestone.</span></li>
      <li><b>Otherwise, priority order within the current milestone.</b> <span>P0, then P1, then P2.</span></li>
      <li><b>Milestone empty?</b> <span>Pull from the next one. Don't pull P2 breadth work forward because it's easy — that's how the LLM layer stayed at "two files" as long as it did.</span></li>
    </ol>
    <p class="kicker">
      <b>A ticket that fits no milestone doesn't get worked.</b> It gets a P3 and a line in the plan.
      The backlog is allowed to be large; the <i>active</i> set has to be small and named.
      <br><br>
      <b>P2 is a commitment, not a graveyard.</b> The 2026-07-26 pivot moved LLM work ahead of parity
      work <i>in time</i>. It cancelled nothing — xDS, the admin server, the corpus scorecard,
      ext_authz/ext_proc, and downstream h2 all remain owed, and v1.0.0 depends on them.
    </p>
  </section>

  <footer>Board (per-WP status): the build board artifact · Backlog (per-WP scope): internal-docs/boards/backlog.yaml · Gates: internal-docs/MILESTONES.md</footer>
</div>

<script>
  const releases = /*__DATA__*/;

  const tagFor = { current: ["now", "shipping now"], shipped: ["done", "shipped"], later: ["later", "planned"] };

  document.getElementById("ladder").innerHTML = releases.map(r => {
    const total = r.done + r.open;
    const pctDone = total ? (r.done / total) * 100 : 0;
    const pctOpen = total ? (r.open / total) * 100 : 0;
    const [tagCls, tagTxt] = tagFor[r.state];
    return `
    <article class="rel ${r.state}">
      <div class="spine">
        <div class="ver">${r.v}</div>
        ${r.when ? `<div class="when">${r.when}</div>` : ""}
        <span class="dot"></span>
      </div>
      <div class="body">
        <div class="head">
          <span class="name">${r.name}</span>
          <span class="tag ${tagCls}">${tagTxt}</span>
        </div>
        <p class="theme">${r.theme}</p>

        <div class="gate">
          <span class="lbl">Ship gate</span>
          <p>${r.gate}</p>
          ${r.verify ? `<span class="verify">↳ ${r.verify}</span>` : ""}
        </div>

        <div class="prog">
          <span class="bar">
            <i class="b-done" style="width:${pctDone}%"></i><i class="b-open" style="width:${pctOpen}%"></i>
          </span>
          <span class="count">${r.done}/${total} WPs closed</span>
        </div>

        ${r.scope ? `<p class="scope">${r.scope}</p>` : ""}

        <div class="subhead">${r.state === "current" ? "Left to close the gate" : "In scope"}</div>
        <ul class="items">
          ${r.left.map(i => `<li><span class="wp">${i.wp}</span><span class="what">${i.what}</span></li>`).join("")}
        </ul>

        ${r.risk ? `<p class="risk"><b>Risk —</b> ${r.risk}</p>` : ""}
      </div>
    </article>`;
  }).join("");
</script>

</body></html>
