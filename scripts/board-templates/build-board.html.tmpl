<title>llm-proxy · build board</title>
<style>
  :root {
    --bg: #f2f5f7; --surface: #ffffff; --surface2: #e9eef2;
    --ink: #1b2430; --muted: #5b6b7a; --line: #d8e0e7;
    --accent: #0e7490; --accent-ink: #ffffff;
    --ok: #2e7d4f; --ready: #b45309; --started: #0e7490; --blocked: #93a0ac;
    --ok-bg: #e3f0e8; --ready-bg: #f6ead9; --started-bg: #dcedf2; --blocked-bg: #eceff2;
    --lane-a: #6d5bb8; --lane-b: #b0562f; --lane-c: #2e6bb0; --lane-d: #3e7a4e;
    --lane-e: #a34b7e; --lane-f: #2c7a73; --lane-g: #5b6b7a; --lane-x: #8a6d1f; --lane-h: #b84a4a;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --shadow: 0 1px 2px rgba(20, 30, 40, .06), 0 2px 8px rgba(20, 30, 40, .05);
    --p0: #b02a37; --p1: #0e7490; --p2: #5b6b7a;
    --p0-bg: #fbe6e8; --p1-bg: #dcedf2; --p2-bg: #eceff2;
    --ms-now: #0e7490; --ms-now-bg: #dcedf2; --ms-next: #5b6b7a; --ms-next-bg: #eceff2;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #10161d; --surface: #1a222b; --surface2: #141b23;
      --ink: #e4eaf0; --muted: #93a1af; --line: #2a3542;
      --accent: #2fa8c4; --accent-ink: #08252c;
      --ok: #57b380; --ready: #d9924a; --started: #2fa8c4; --blocked: #6d7a86;
      --ok-bg: #1b2f24; --ready-bg: #33271a; --started-bg: #16303a; --blocked-bg: #212a33;
      --lane-a: #9d8ad9; --lane-b: #d18660; --lane-c: #6d9bd4; --lane-d: #74ac82;
      --lane-e: #c97fa8; --lane-f: #63aaa3; --lane-g: #8fa0af; --lane-x: #c0a457; --lane-h: #d47f7f;
      --shadow: 0 1px 2px rgba(0, 0, 0, .35);
      --p0: #ef7a86; --p1: #2fa8c4; --p2: #8fa0af;
      --p0-bg: #3a1f24; --p1-bg: #16303a; --p2-bg: #212a33;
      --ms-now: #2fa8c4; --ms-now-bg: #16303a; --ms-next: #8fa0af; --ms-next-bg: #212a33;
    }
  }
  :root[data-theme="light"] {
    --bg: #f2f5f7; --surface: #ffffff; --surface2: #e9eef2;
    --ink: #1b2430; --muted: #5b6b7a; --line: #d8e0e7;
    --accent: #0e7490; --accent-ink: #ffffff;
    --ok: #2e7d4f; --ready: #b45309; --started: #0e7490; --blocked: #93a0ac;
    --ok-bg: #e3f0e8; --ready-bg: #f6ead9; --started-bg: #dcedf2; --blocked-bg: #eceff2;
    --lane-a: #6d5bb8; --lane-b: #b0562f; --lane-c: #2e6bb0; --lane-d: #3e7a4e;
    --lane-e: #a34b7e; --lane-f: #2c7a73; --lane-g: #5b6b7a; --lane-x: #8a6d1f; --lane-h: #b84a4a;
    --shadow: 0 1px 2px rgba(20, 30, 40, .06), 0 2px 8px rgba(20, 30, 40, .05);
    --p0: #b02a37; --p1: #0e7490; --p2: #5b6b7a;
    --p0-bg: #fbe6e8; --p1-bg: #dcedf2; --p2-bg: #eceff2;
    --ms-now: #0e7490; --ms-now-bg: #dcedf2; --ms-next: #5b6b7a; --ms-next-bg: #eceff2;
  }
  :root[data-theme="dark"] {
    --bg: #10161d; --surface: #1a222b; --surface2: #141b23;
    --ink: #e4eaf0; --muted: #93a1af; --line: #2a3542;
    --accent: #2fa8c4; --accent-ink: #08252c;
    --ok: #57b380; --ready: #d9924a; --started: #2fa8c4; --blocked: #6d7a86;
    --ok-bg: #1b2f24; --ready-bg: #33271a; --started-bg: #16303a; --blocked-bg: #212a33;
    --lane-a: #9d8ad9; --lane-b: #d18660; --lane-c: #6d9bd4; --lane-d: #74ac82;
    --lane-e: #c97fa8; --lane-f: #63aaa3; --lane-g: #8fa0af; --lane-x: #c0a457; --lane-h: #d47f7f;
    --shadow: 0 1px 2px rgba(0, 0, 0, .35);
    --p0: #ef7a86; --p1: #2fa8c4; --p2: #8fa0af;
    --p0-bg: #3a1f24; --p1-bg: #16303a; --p2-bg: #212a33;
    --ms-now: #2fa8c4; --ms-now-bg: #16303a; --ms-next: #8fa0af; --ms-next-bg: #212a33;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: var(--sans); font-size: 14px; line-height: 1.45;
  }

  header {
    position: sticky; top: 0; z-index: 5;
    background: var(--bg); border-bottom: 1px solid var(--line);
    padding: 18px 22px 14px;
    /* A sticky header with no cap can grow until it fills the viewport and
       pushes the board itself off-screen -- which is exactly what happened
       once the "now" panel accumulated a few batches of prose. The board is
       the page; the header is context. Cap it and let the context scroll. */
    max-height: 62vh; overflow-y: auto;
  }
  .eyebrow {
    font-family: var(--mono); font-size: 11px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--muted); margin: 0 0 4px;
  }
  h1 {
    font-family: var(--mono); font-size: 21px; font-weight: 600;
    margin: 0 0 12px; letter-spacing: -.01em; text-wrap: balance;
  }
  h1 .dim { color: var(--muted); font-weight: 400; }

  .chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .chips .sep { width: 1px; height: 18px; background: var(--line); margin: 0 6px; }
  .chip {
    font-family: var(--mono); font-size: 12px; cursor: pointer;
    border: 1px solid var(--line); border-radius: 999px;
    background: var(--surface); color: var(--ink); padding: 3px 11px;
  }
  .chip:hover { border-color: var(--accent); }
  .chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .chip .n { opacity: .65; margin-left: 4px; font-variant-numeric: tabular-nums; }
  .hint { font-size: 12px; color: var(--muted); margin: 10px 0 0; }

  .now {
    margin: 12px 0 0; padding: 9px 12px; border-radius: 6px;
    background: var(--surface); border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    font-size: 12.5px; line-height: 1.5; max-width: 82ch;
  }
  .now b { font-family: var(--mono); font-size: 12px; }
  .now .sub { color: var(--muted); }
  .now code { font-family: var(--mono); font-size: 11.5px; background: var(--surface2); padding: 0 4px; border-radius: 3px; }
  .gate {
    display: block; margin: 8px 0 0; padding: 7px 10px; border-radius: 5px;
    background: var(--surface2); border-left: 2px solid var(--ready);
    font-family: var(--mono); font-size: 11.5px; line-height: 1.5;
  }

  .board-wrap { overflow-x: auto; padding: 18px 22px 30px; }
  .board { display: flex; gap: 14px; align-items: flex-start; min-width: max-content; }

  .lane { width: 256px; flex: 0 0 auto; }
  .lane-head {
    display: flex; align-items: baseline; gap: 8px;
    padding: 2px 4px 8px; border-bottom: 2px solid var(--line);
    margin-bottom: 10px;
  }
  .lane-dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; align-self: center; }
  .lane-name { font-family: var(--mono); font-size: 12.5px; font-weight: 700; letter-spacing: .02em; }
  .lane-sub { font-size: 11px; color: var(--muted); margin-left: auto; font-variant-numeric: tabular-nums; }
  .lane-cards { display: flex; flex-direction: column; gap: 8px; }

  .card {
    background: var(--surface); border: 1px solid var(--line); border-left-width: 3px;
    border-radius: 6px; padding: 9px 11px 9px 10px; box-shadow: var(--shadow);
    transition: opacity .15s ease;
