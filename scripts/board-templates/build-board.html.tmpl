<div class="board-wrap">
  <div class="board" id="board"></div>
</div>

<script>
  const lanes = [
    { id: "A", name: "A · Foundations", color: "var(--lane-a)" },
    { id: "B", name: "B · Runtime / L4", color: "var(--lane-b)" },
    { id: "C", name: "C · HTTP", color: "var(--lane-c)" },
    { id: "D", name: "D · Cluster", color: "var(--lane-d)" },
    { id: "E", name: "E · xDS", color: "var(--lane-e)" },
    { id: "F", name: "F · Observability", color: "var(--lane-f)" },
    { id: "G", name: "G · Test infra", color: "var(--lane-g)" },
    { id: "X", name: "Filters", color: "var(--lane-x)" },
    { id: "H", name: "H · LLM layer", color: "var(--lane-h)" },
  ];

  const CURRENT_MS = "v0.3.2";

  // status: done | ready | started | blocked ; ms = the release the WP closes in
  const wps = /*__DATA__*/;

  const board = document.getElementById("board");
  for (const lane of lanes) {
    const cards = wps.filter(w => w.lane === lane.id);
    const doneN = cards.filter(w => w.status === "done").length;
    const col = document.createElement("section");
    col.className = "lane";
    col.innerHTML = `
      <div class="lane-head" style="border-bottom-color:${lane.color}">
        <span class="lane-dot" style="background:${lane.color}"></span>
        <span class="lane-name">${lane.name}</span>
        <span class="lane-sub">${doneN}/${cards.length}</span>
      </div>
      <div class="lane-cards"></div>`;
    const holder = col.querySelector(".lane-cards");
    for (const w of cards) {
      const el = document.createElement("article");
      el.className = `card ${w.status}`;
      el.dataset.status = w.status;
      el.dataset.gate = w.gate;
      el.dataset.prio = w.prio;
      el.dataset.ms = w.ms;
      const prioTitle = {
        P0: "Product-defining — the LLM gateway itself",
        P1: "Serving-critical — needed to run real traffic",
        P2: "Envoy parity / breadth — backlog, not dropped",
      }[w.prio];
      el.innerHTML = `
        <div class="card-top">
          <span class="wp" style="color:${lane.color}">WP-${String(w.id).padStart(2, "0")}</span>
          <span class="size">${w.size}</span>
          <span class="badge prio prio-${w.prio}" title="${prioTitle}">${w.prio}</span>
        </div>
        <div class="card-title">${w.title}</div>
        <div class="card-tags">
          <span class="badge status-${w.status}">${w.status}</span>
          <span class="badge gate">${w.gate}</span>
          <span class="badge ms${w.ms === CURRENT_MS ? " ms-now" : ""}" title="Ships in ${w.ms}">${w.ms}</span>
        </div>
        <div class="card-meta">${w.meta.map(m => `<span>${m}</span>`).join("")}</div>
        ${w.note ? `<div class="flag">${w.note}</div>` : ""}`;
      holder.appendChild(el);
    }
    board.appendChild(col);
  }

  for (const s of ["done", "ready", "started", "blocked"]) {
    document.getElementById("n-" + s).textContent = wps.filter(w => w.status === s).length;
  }
  for (const pr of ["P0", "P1", "P2"]) {
    document.getElementById("n-" + pr).textContent = wps.filter(w => w.prio === pr).length;
  }
  for (const [ms, id] of [["v0.0.1", "n-v001"], ["v0.1.0", "n-v010"], ["v0.2.0", "n-v020"],
                          ["v0.3.0", "n-v030"], ["v0.3.2", "n-v032"], ["v0.3.3", "n-v033"], ["v0.4.0", "n-v040"], ["v1.0.0", "n-v100"]]) {
    document.getElementById(id).textContent = wps.filter(w => w.ms === ms).length;
  }

  let active = null; // { key: "status" | "prio" | "ms" | "gate", value: string }
  const chips = document.querySelectorAll(".chip");
  const keyOf = c => c.dataset.status ? "status" : c.dataset.prio ? "prio" : c.dataset.ms ? "ms" : "gate";
  const valOf = c => c.dataset.status || c.dataset.prio || c.dataset.ms || c.dataset.gate;
  chips.forEach(chip => {
    chip.setAttribute("aria-pressed", "false");
    chip.addEventListener("click", () => {
      const key = keyOf(chip), value = valOf(chip);
      active = (active && active.key === key && active.value === value) ? null : { key, value };
      chips.forEach(c => {
        c.setAttribute("aria-pressed", String(!!active && active.key === keyOf(c) && active.value === valOf(c)));
      });
      document.querySelectorAll(".card").forEach(card => {
        card.classList.toggle("dim", !!active && card.dataset[active.key] !== active.value);
      });
    });
  });
</script>

</body></html>
