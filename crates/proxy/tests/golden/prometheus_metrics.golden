envoy_gen_ai_server_time_per_output_token histogram gen_ai_operation_name,gen_ai_provider_name,gen_ai_request_model
envoy_gen_ai_server_time_to_first_token histogram gen_ai_operation_name,gen_ai_provider_name,gen_ai_request_model
envoy_llm_client_token_usage counter provider,tenant,type
